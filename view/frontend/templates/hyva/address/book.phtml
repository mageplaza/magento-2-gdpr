/** @var \Magento\Customer\Block\Address\Book $block */

/** @var \Mageplaza\Gdpr\Helper\Data $helper */
$helper = $this->helper(\Mageplaza\Gdpr\Helper\Data::class);

$defaultBillingAddressId  = $block->getDefaultBilling();
$defaultShippingAddressId = $block->getDefaultShipping();
$themeCode                = $helper->getCurrentTheme();

if ($helper->allowDeleteDefaultAddress()): ?>
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            "use strict";

            <?php if ($defaultBillingAddressId): ?>
            let boxBillingActions, deleteBillingEl;

            boxBillingActions = document.querySelector('.block-addresses-default .box-address-billing .box-actions');
            deleteBillingEl   = `<a class="action delete mp-gdpr-delete btn bg-red-500"
            href="<?=  /** @noEscape */ $block->getUrl('customer/address/delete/') . $defaultBillingAddressId ?>"
            <span><?= /** @noEscape */ __('Delete Address') ?></span></a>`;

            if (boxBillingActions) {
                boxBillingActions.insertAdjacentHTML('beforeend', deleteBillingEl);
            }
            <?php endif; ?>

            <?php if ($defaultShippingAddressId): ?>
            let boxShippingActions, deleteShippingEl;

            boxShippingActions = document.querySelector('.block-addresses-default .box-address-shipping .box-actions');
            deleteShippingEl   = `<a class="action delete mp-gdpr-delete btn bg-red-500"
            href="<?=  /** @noEscape */ $block->getUrl('customer/address/delete/') . $defaultShippingAddressId ?>"
            <span><?= /** @noEscape */ __('Delete Address') ?></span></a>`;

            if (boxShippingActions) {
                boxShippingActions.insertAdjacentHTML('beforeend', deleteShippingEl);
            }
            <?php endif; ?>
        });
    </script>

<?php endif; ?>
<style>
    .mp-gdpr-delete {
        width: fit-content;
        display: inline-block;
        float: right;
    }

    .box-actions a {
        width: fit-content;
    }
</style>