/** @var \Mageplaza\Gdpr\Block\Address\Account $block */

if ($block->allowDeleteAccount()): ?>
    <div x-data="deleteAccountHandler()" class="mp-gdpr-delete-customer-account col-mp mp-12 mp-xs-12">
        <fieldset class="fieldset info mp-gdpr-delete-account">
            <legend class="legend">
                <span><?= /** @noEscape */ __('Delete Account') ?></span>
            </legend><br>
            <div class="actions-toolbar">
                <div class="gdpr-delete-message col-mp mp-12 mp-xs-12" style="word-break: break-word"><?= /** @noEscape */ __($block->getDeleteAccountMessage())?></div>
            </div>
            <?= /** @noEscape */ $block->getChildHtml('form_additional_info') ?>
            <div class="col-mp mp-12 mp-xs-12">
                <div class="primary">
                    <button type="button" class="action save action-delete mp-delete-btn"
                            @click="openModal" title="<?= /** @noEscape */ __('Delete your account') ?>">
                        <span><?= /** @noEscape */ __('Delete your account') ?></span>
                    </button>
                </div>
            </div>
        </fieldset>
        <div x-show="isOpen" x-cloak x-transition
             class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div class="modal-container bg-white p-6 shadow-lg">
                <?php if ($block->isVerifyPassword()) :?>
                <header class="modal-header">
                    <h2 class="text-xl font-semibold mb-4"><?= /** @noEscape */ __('Please confirm password') ?></h2>
                </header>
                <div class="modal-content">
                    <input type="password" x-model="password" class="border p-2 w-full mb-4 px-4" placeholder="Enter your password"/>
                    <p x-show="errorMessage" class="message error text-sm" x-text="errorMessage"></p>
                    <div class="flex justify-end space-x-2 px-4">
                        <button @click="closeModal" class="btn-cancel px-4"><?= /** @noEscape */ __('Cancel') ?></button>
                        <button @click="confirmPassword" class="action-primary px-4 py-2 text-white border"><?= /** @noEscape */ __('Confirm') ?></button>
                    </div>
                </div>
                <?php else:?>
                    <header class="modal-header">
                        <h2 class="text-xl font-semibold mb-4"><?= /** @noEscape */ __('Are you sure you want to delete your account?')?></h2>
                    </header>
                <div class="modal-content">
                    <div class="flex justify-end space-x-2 px-4">
                        <button @click="closeModal" class="btn-cancel px-4"><?= /** @noEscape */ __('Cancel') ?></button>
                        <button @click="confirm" class="action-primary px-4 py-2 text-white border"><?= /** @noEscape */ __('Ok') ?></button>
                    </div>
                </div>
                <?php endif;?>
            </div>
        </div>
    </div>
    <script>
        function deleteAccountHandler() {
            return {
                isOpen: false,
                password: '',
                errorMessage: '',
                deleteUrl: '<?= /** @noEscape */ $block->escapeUrl(rtrim($block->getDeleteAccountUrl(), '/')) ?>',
                <?php if ($block->isVerifyPassword()) :?>
                    checkPasswordUrl: '<?= /** @noEscape */ $block->getExtraData()['checkpasswordUrl'] ?>',
                <?php endif;?>

                openModal() {
                    this.isOpen = true;
                    this.errorMessage = '';
                    this.password = '';
                },
                closeModal() {
                    this.isOpen = false;
                },
                <?php if ($block->isVerifyPassword()) :?>
                    confirmPassword() {
                        if (!this.password) {
                            this.errorMessage = '<?= /** @noEscape */ __('Password is empty, please fill out your password again!') ?>';
                            return;
                        }

                        fetch(this.checkPasswordUrl + '?form_key=' + hyva.getFormKey(), {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                password: this.password
                            })
                        })
                        .then((response) => {
                            return response.json()
                        })
                        .then((data) => {
                            if (data.status) {
                                window.location.href = this.deleteUrl;
                            } else {
                                this.errorMessage = '<?= /** @noEscape */ __('Password is not correct. Please try again!') ?>';
                            }
                        })
                        .catch((error) => {
                            this.errorMessage = '<?= /** @noEscape */ __('An error occurred. Please try again.') ?>';
                        });
                    }
                <?php else: ?>
                    confirm() {
                        window.location.href = this.deleteUrl;
                    }
                <?php endif; ?>
            };
        }
    </script>
    <style>
        .modal-container{
            width: 30%;
            margin-top: -35rem;
            padding: 1.5rem 2rem;
        }
        .modal-container h2 {
            border-bottom: 1px solid #c1c1c1;
            font-weight: 300;
            padding-bottom: 10px;
            font-size: 26px;
            min-height: 1em;
            word-wrap: break-word;
        }
        .btn-cancel {
            margin-top: 20px;
        }
        .action-primary {
            background-color: #1d4ed8;
            color: #fff;
            padding: 0.5rem 1rem;
            font-size: .875rem;
            line-height: 1.25rem;
            border-radius: .5rem;
            margin-top: 20px;
        }
    </style>
<?php endif; ?>
